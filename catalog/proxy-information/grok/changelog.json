      "changes": [
        {
          "category": "changed",
          "text": "Update the managed Grok CLI to 1.0.46. Catalog inspection no longer delays shutdown: failed cleanup and empty snapshots are retried and only inspection children are force-stopped. Confirmation prompts explicitly declare the action that may omit answers. The standalone package uses public Proxy Protocol SDK 1.0.2; the wire protocol range is unchanged. Real model turns were not run for this release.",
          "evidence": [
            "https://github.com/RichLogic/Gian-Proxies/releases/tag/proxy-grok-v0.3.8",
            "https://github.com/RichLogic/Gian-Proxies/blob/proxy-grok-v0.3.8/packages/proxies/grok-proxy/README.md"
          ]
