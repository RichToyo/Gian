            "https://github.com/RichLogic/Gian-Proxies/releases/tag/proxy-zcode-v0.4.4",
            "https://github.com/RichLogic/Gian-Proxies/blob/proxy-zcode-v0.4.4/packages/proxies/zcode-proxy/README.md"
